# Export checkpoints with state dicts matching these output label orders.
XRAY_CHECKPOINT=artifacts/weights/xray.pth
SKIN_CHECKPOINT=artifacts/weights/skin.pth
XRAY_LABELS=["Atelectasis","Cardiomegaly","Effusion","Infiltration","Mass","Nodule","Pneumonia","Pneumothorax","Consolidation","Edema","Emphysema","Fibrosis","Pleural_Thickening","Hernia"]
SKIN_LABELS=["MEL","NV","BCC","AKIEC","BKL","DF","VASC","SCC"]

# Optional isolated binary experiment inference. To use one, replace that
# modality's checkpoint AND label list, e.g.:
# XRAY_CHECKPOINT=artifacts/weights/xray_binary_10k_v2.pth
# XRAY_LABELS=["No Finding","Pneumonia"]
# SKIN_CHECKPOINT=artifacts/weights/skin_binary_10k_v2.pth
# SKIN_LABELS=["MEL","NV"]

# Add your own API key locally. Do not commit a populated .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GUIDELINES_DIR=data/guidelines
CHROMA_DIR=artifacts/chroma_db
CHROMA_COLLECTION=clinical_guidelines
EMBEDDING_MODEL=dmis-lab/biobert-base-cased-v1.1
EMBEDDING_DEVICE=cpu
RAG_TOP_K=4
RAG_AUTO_INDEX=true
MAX_UPLOAD_BYTES=12000000
MAX_IMAGE_PIXELS=40000000
